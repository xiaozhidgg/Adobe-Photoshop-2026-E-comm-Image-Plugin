{
  "manifestVersion": 5,
  "id": "com.ecom.psimage",
  "name": "电商图片制作",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ecomMainPanel",
      "label": {
        "default": "电商图片制作"
      },
      "minimumSize": { "width": 300, "height": 400 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 720 },
      "preferredFloatingSize": { "width": 320, "height": 720 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "extensions": [".jpg", ".jpeg", ".png", ".psd", ".tif", ".tiff", ".bmp", ".webp", ""],
      "schemes": ["https"]
    }
  }
}
